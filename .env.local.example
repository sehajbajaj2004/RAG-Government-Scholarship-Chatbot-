# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# None of these are NEXT_PUBLIC_* — they are server-side only (RAG-5, NFR-3).

# Google AI Studio key (free tier, no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Qdrant Cloud free cluster: https://cloud.qdrant.io
# URL looks like https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
